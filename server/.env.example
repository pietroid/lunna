# This is an example file for local overrides. By default the app loads:
#   .env.{NODE_ENV}.local  ->  .env.{NODE_ENV}  ->  .env.local  ->  .env
#
# Committed files:
#   .env.production ->  PORT=3000 (used on the Raspberry Pi)
#
# Keep local-only changes in .env.local (this file is gitignored).

PORT=3000

# Optional: only set this if Application Default Credentials cannot infer the
# Firebase project. The backend authenticates with the service account key
# pointed to by GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_PROJECT_ID=your-project-id

# Firebase / GCP project used for deployment and service account resolution.
# PROJECT_ID=your-project-id

# Service account email used by the backend.
# BACKEND_SERVICE_ACCOUNT=your-service-account@your-project-id.iam.gserviceaccount.com

# Path to the Firebase service account JSON key (kept outside the repo).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/key.json

# Comma-separated list of Google accounts allowed to sign in.
# ALLOWED_GOOGLE_EMAILS=alice@gmail.com,bob@gmail.com

# Internal agent service. The agent is reachable only inside the Docker network.
# AGENT_URL=http://focus-agent:3002

# Agent request timeouts (milliseconds).
# AGENT_REPLY_TIMEOUT_MS=60000
# AGENT_EXECUTE_TOOL_TIMEOUT_MS=30000
