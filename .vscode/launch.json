{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lunna - Dev",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "lunnaDev",
        "--dart-define-from-file",
        "env/lunna.dev.json"
      ]
    },
    {
      "name": "Lunna - Dev (web)",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "5173",
        "--dart-define-from-file",
        "env/lunna.dev.json"
      ]
    },
    {
      "name": "Lunna - Production",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "lunnaProduction",
        "--dart-define-from-file",
        "env/lunna.production.json"
      ]
    },
    {
      "name": "Lunna - Production Profile",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "lunnaProduction",
        "--profile",
        "--dart-define-from-file",
        "env/lunna.production.json"
      ]
    },
    {
      "name": "Focus - Dev",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "focusDev",
        "--dart-define-from-file",
        "env/focus.dev.json"
      ]
    },
    {
      "name": "Focus - Dev (web)",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "5173",
        "--dart-define-from-file",
        "env/focus.dev.json"
      ]
    },
    {
      "name": "Focus - Production",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "focusProduction",
        "--dart-define-from-file",
        "env/focus.production.json"
      ]
    },
    {
      "name": "Focus - Production Profile",
      "request": "launch",
      "type": "dart",
      "program": "app/lib/main.dart",
      "args": [
        "--flavor",
        "focusProduction",
        "--profile",
        "--dart-define-from-file",
        "env/focus.production.json"
      ]
    },
    {
      "name": "Server - Local",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "autoAttachChildProcesses": true
    }
  ]
}
