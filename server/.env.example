# Copy to .env.local for development. On the Pi the same keys live in
# /opt/lunna/.env, next to docker-compose.yml.
#
# Load order: .env.{NODE_ENV}.local -> .env.{NODE_ENV} -> .env.local -> .env

PORT=3000

# Postgres. Neon in both places: a `dev` branch for local work and the main
# branch in production. Use the pooled or direct URL; keep sslmode=require.
# Offline? `npm run db:local` and point this at
# postgresql://postgres@localhost:5433/postgres?sslmode=disable
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth.
# The public origin the app is served from. Dev: the server itself.
# Production serves both brands from one server, so list both, comma
# separated, the fallback first:
#   https://lunna.pietroteruya.dev,https://focus.pietroteruya.dev
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Extra origins a browser may call from: the Flutter web dev server.
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth clients, comma separated, Lunna's web client first: it does
# Lunna's redirect flow and owns GOOGLE_CLIENT_SECRET. Then every other
# client whose ID tokens the server accepts, from either Google project:
# Focus's web client (the phones' tokens are minted for it) and each iOS
# client.
GOOGLE_CLIENT_IDS=WEB_CLIENT_ID.apps.googleusercontent.com,IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Focus's web client, in Focus's own Google project, for Focus's redirect
# flow (the `google-focus` provider). Leave both empty locally: one dev
# project serves both brands through `google`.
FOCUS_GOOGLE_CLIENT_ID=
FOCUS_GOOGLE_CLIENT_SECRET=

# Who may sign up, comma separated. Empty lets any Google account in.
ALLOWED_EMAILS=

# The zone a new person's day starts in.
LUNNA_TIMEZONE=America/Sao_Paulo

# The agent (Lunna), through OpenRouter. Leave the key empty and the agent
# answers 503 "não está conectada"; everything else works without it.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calls.
OPENROUTER_MODEL=
