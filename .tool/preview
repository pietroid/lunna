#!/usr/bin/env bash
# Builds a preview entry point (app/lib/<slug>_preview.dart), screenshots its
# scenes as a phone, and lays out the strip or the board, in one call. Prints
# the paths of what it made; a failed build prints its errors.
#
# Usage: .tool/preview <slug> <scene>... [--lang en|pt] [--out <dir>]
#                      [--steps <steps.txt>] [--board <board.json>] [--no-build]
#   <out>/<n>.png and strip.png; with --steps (one line per scene),
#   <out>/steps.png, the step-by-step strip /mockup sends; with --board, the
#   board in <out>/board/. --lang picks the copy the app draws: English by
#   default, so prints are read in the language the work is talked about in
#   (the shipped app is pt-BR; the entry point reads it as `previewLocale`).
#   --no-build reshoots the last build, for when only the board or a wait changed.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
slug=${1:?usage: .tool/preview <slug> <scene>... [--lang en|pt] [--out dir] [--steps steps.txt] [--board board.json] [--no-build]}
shift
scenes=""; lang="en"; out="${TMPDIR:-/tmp}/lunna-preview/$slug"; board=""; steps=""; build=1
while [ $# -gt 0 ]; do
  case $1 in
    --lang) lang=$2; shift ;;
    --out) out=$2; shift ;;
    --board) board=$2; shift ;;
    --steps) steps=$(cd "$(dirname "$2")" && pwd)/$(basename "$2"); shift ;;
    --no-build) build=0 ;;
    *) scenes="$scenes $1" ;;
  esac
  shift
done
[ -n "$scenes" ] || { echo "name at least one scene"; exit 2; }
mkdir -p "$out"; out=$(cd "$out" && pwd)
entry="lib/${slug}_preview.dart"
[ -f "$root/app/$entry" ] || entry="lib/$slug.dart"
[ -f "$root/app/$entry" ] || { echo "no app/lib/${slug}_preview.dart"; exit 2; }

if [ $build = 1 ]; then
  start=$SECONDS; log="$out/build.log"
  if ! (cd "$root/app" && flutter build web -t "$entry" --dart-define=PREVIEW_LANG=$lang \
    --no-tree-shake-icons --no-wasm-dry-run -o "$out/web") >"$log" 2>&1; then
    grep -nE 'Error|error:|Exception|Unable' "$log" | head -30 || tail -15 "$log"
    echo "✗ build failed; log: $log"
    exit 1
  fi
  echo "✓ built ($lang, $((SECONDS - start))s)"
fi

STEPS="$steps" "$root/.tool/mockup/shoot-flutter.sh" "$out/web" "$out" $scenes >/dev/null 2>"$out/shoot.log" \
  || { echo "✗ screenshots failed; see $out/shoot.log"; exit 1; }
echo "$out/strip.png ($(for s in $scenes; do printf '%s.png ' "$s"; done))"
[ -n "$steps" ] && echo "steps: $out/steps.png (look at steps-thumb.png)"

# Off-token lines this branch added to the app: a literal colour, font size or
# padding instead of AppColors / AppTypography / AppSpacing. The theme itself
# defines them, so it is skipped. At most 12 lines.
base=$(git -C "$root" merge-base HEAD origin/main 2>/dev/null)
if [ -n "$base" ]; then
  git -C "$root" diff -U0 "$base" -- 'app/lib/*.dart' 'app/packages/*.dart' ':!app/packages/app_ui/lib/src/theme' ':!*/gen/*' ':!*_test.dart' \
    | awk '/^\+\+\+ b\//{f=substr($0,7)} /^@@/{split($3,a,",");n=substr(a[1],2)-1} /^\+[^+]/{n++; if ($0 ~ /Color\(0x|fontSize: *[0-9]|EdgeInsets\.[a-zA-Z]+\([^)A-Za-z]*[1-9]|BorderRadius\.circular\([0-9]|[^A-Za-z]TextStyle\(/) print "⚠ off-token " f ":" n ": " substr($0,2)}' \
    | sed 's/  */ /g' | head -12
fi

if [ -n "$board" ]; then
  node "$root/.tool/mockup/board.mjs" "$board" "$out/board" >/dev/null || exit 1
  echo "board: $out/board/board.png"
fi
