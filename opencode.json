{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "gh *": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "flutter run*": "deny",
      "npm run start*": "deny",
      "npm run eval*": "deny",
      "npm run db:*": "deny",
      "npm publish*": "deny"
    }
  }
}
