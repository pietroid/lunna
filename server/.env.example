# Copy to .env.local for development. On the Pi the same keys live in
# /opt/lunna/.env, next to docker-compose.yml.
#
# Load order: .env.{NODE_ENV}.local -> .env.{NODE_ENV} -> .env.local -> .env

PORT=3000

# Postgres. Neon in both places: a `dev` branch for local work and the main
# branch in production. Use the pooled or direct URL; keep sslmode=require.
# Offline? `npm run db:local` and point this at
# postgresql://postgres@localhost:5433/postgres?sslmode=disable
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth.
# The public origin the app is served from. Dev: the server itself.
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Extra origins a browser may call from: the Flutter web dev server.
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth clients, comma separated, web client first. The web client
# does the redirect flow (and owns the secret); the iOS and Android clients
# only mint ID tokens the server accepts.
GOOGLE_CLIENT_IDS=WEB_CLIENT_ID.apps.googleusercontent.com,IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Who may sign up, comma separated. Empty lets any Google account in.
ALLOWED_EMAILS=

# The zone a new person's day starts in.
LUNNA_TIMEZONE=America/Sao_Paulo
